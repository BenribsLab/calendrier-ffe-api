# Copier en .env et adapter. Toutes les variables sont facultatives.

# --- Docker : port et adresse d'écoute sur la machine hôte (le conteneur écoute toujours sur 8765) ---
API_PORT=8765
# 127.0.0.1 = accessible uniquement depuis la machine (derrière Apache) ; 0.0.0.0 = depuis le réseau
API_BIND=127.0.0.1

# --- API ---
# URL publique de l'API (liens des flux .ics). En local : http://127.0.0.1:<API_PORT>
CAL_PUBLIC_URL=https://calendrier-ffe.benribs.fr
CAL_USER_AGENT=calendrier-ffe.benribs.fr (+https://calendrier-ffe.benribs.fr)
# CAL_DATA_DIR est fixé à /data dans le conteneur (docker-compose.yml)

# Jeton pour POST /calendriers/{source}/refresh (générer : python -c "import secrets; print(secrets.token_urlsafe(32))")
CAL_ADMIN_TOKEN=

# Cache de la liste FFE (secondes). 0 = strict temps réel.
CAL_FFE_LIST_TTL=180
CAL_FFE_DETAIL_TTL=1800

# Heure (locale) de l'analyse quotidienne des calendriers PDF (CDE 91, Ligue IDF)
CAL_CALENDRIERS_REFRESH_HOUR=6

# Sources par défaut quand ?source= n'est pas précisé
CAL_DEFAULT_SOURCES=ffe,cde91,idf

# Origines autorisées (CORS) pour les appels depuis un navigateur, séparées par des virgules
CAL_CORS_ORIGINS=*
